{
  "title": "我的信息台",
  "subtitle": "一句话说明这个台子是干什么的",

  "theme": {
    "name": "mckinsey"
  },

  "idFields": ["名称", "分类"],

  "columns": [
    { "key": "名称", "label": "名称", "type": "text",  "width": 220, "filter": false, "sort": true,  "search": true },
    { "key": "分类", "label": "分类", "type": "tags",  "width": 130, "filter": true,  "sort": true,  "search": true },
    { "key": "截止", "label": "截止", "type": "date",  "width": 110, "filter": false, "sort": true,  "search": false },
    { "key": "链接", "label": "链接", "type": "link",  "width": 80,  "filter": false, "sort": false, "search": false }
  ],

  "status": {
    "enabled": true,
    "options": ["未开始", "进行中", "已完成", "已放弃"],
    "default": "未开始"
  },

  "kpis": [
    { "label": "总条目",   "op": "count" },
    { "label": "进行中",   "op": "countWhere", "key": "__status", "eq": "进行中" },
    { "label": "7天内到期", "op": "dueWithin", "key": "截止", "days": 7 }
  ]
}
